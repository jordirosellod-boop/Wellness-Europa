# Copia aquest fitxer com a .env.local per provar-ho al teu ordinador.
# A Vercel, aquests valors es posen a Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clau secreta: NOMÉS a Vercel (mai al codi ni al xat).
SUPABASE_SECRET_KEY=sb_secret_xxx
